# ################
# SERVER
# ################

# HTTP_ADDRESS=:8080
# HTTPS_REDIRECT_PORT=80
# ENABLE_HTTP_REDIRECT=TRUE
# NETWORK_TEST_ON_START=TRUE
# INCLUDE_PUBLIC_IP_IN_NAT_1_TO_1_IP=TRUE

# ################
# SSL
# ################

# USE_SSL=TRUE
# SSL_KEY=./certs/key.pem
# SSL_CERT=./certs/cert.pem

# ################
# AUTHORIZATION
# ################

# LOCAL STREAM PROFILES
# STREAM_PROFILE_PATH=./profiles
# STREAM_PROFILE_POLICY=ANYONE_WITH_RESERVED

# PASSWORDS
# PASSWORD covers both watching and publishing. Either can be given its own
# secret instead, and a specific one always overrides PASSWORD.
# Viewers get a browser password prompt; broadcasters put the stream password
# ahead of their stream key, as <streamPassword>:<streamKey>.
# PASSWORD=ChangeMe
# SITE_PASSWORD=ChangeMe
# STREAM_PASSWORD=ChangeMe

# WEBHOOK AUTHORIZATION
# WEBHOOK_URL=http://your-server

# ################
# FRONTEND
# ################

# DISABLE_FRONTEND=TRUE
# FRONTEND_PATH="./web/build"
# FRONTEND_ADMIN_TOKEN=ChangeMe

# Site name shown in the header and browser tab (build-time, frontend). Default: Broadcast Box
# VITE_SITE_NAME="Broadcast Box"

# ################
# DEBUGGING
# ################

# DEBUG_INCOMING_API_REQUEST=TRUE
# DEBUG_PRINT_ANSWER=TRUE
# DEBUG_PRINT_OFFER=TRUE

# ################
# LOGGING
# ################
# LOGGING_LEVEL=INFO

# ################
# CHAT
# ################
# CHAT_MAX_HISTORY=10000
# CHAT_DEFAULT_TTL=72h
# CHAT_CLEANUP_INTERVAL=1h
